# ==========================================
# BACKEND WEB SERVICE ENVIRONMENT VARIABLES
# ==========================================

# DATABASE_URL: Connection string for SQLite database
DATABASE_URL="file:./dev.db"

# PORT: Server port (defaults to 3000 if not specified)
PORT=3000

# NODE_ENV: Node environment ('production' or 'development')
NODE_ENV="production"

# GEMINI_API_KEY: Required for Gemini AI API calls
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where the backend web service is hosted
APP_URL="https://your-backend-service.onrender.com"

# ==========================================
# FRONTEND STATIC SITE ENVIRONMENT VARIABLES
# ==========================================

# VITE_API_BASE_URL: Backend API base URL for static frontend (if hosted separately)
# Example: https://your-backend-service.onrender.com
VITE_API_BASE_URL="https://your-backend-service.onrender.com"
