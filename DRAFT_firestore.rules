rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && isEmailVerified() && getUserData().role == role;
    }

    function isAdmin() { return hasRole('admin'); }
    function isDoctor() { return hasRole('doctor'); }
    function isNurse() { return hasRole('nurse'); }
    function isStaff() { return isSignedIn() && isEmailVerified(); }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.email == request.auth.token.email &&
             data.role in ['doctor', 'nurse', 'admin'] &&
             data.createdAt == request.time;
    }

    function isValidPatient(data) {
      return data.keys().hasAll(['id', 'name', 'gender', 'dob', 'status']) &&
             data.id is string &&
             data.name is string && data.name.size() < 200 &&
             data.gender in ['male', 'female', 'other'] &&
             data.status in ['inpaitient', 'outpatient', 'discharged'];
    }

    function isValidNote(data) {
       return data.keys().hasAll(['id', 'patientId', 'authorId', 'type', 'content', 'createdAt']) &&
              data.authorId == request.auth.uid &&
              data.createdAt == request.time &&
              data.content is string && data.content.size() < 5000;
    }

    // --- Collection Matches ---

    match /users/{uid} {
      allow read: if isStaff();
      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if isAdmin() && isValidUser(incoming());
    }

    match /wards/{wardId} {
      allow read: if isStaff();
      allow write: if isAdmin();
      
      match /beds/{bedId} {
        allow read: if isStaff();
        allow create: if isAdmin();
        allow update: if isStaff() && 
          (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'patientId']));
      }
    }

    match /patients/{patientId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidPatient(incoming());
      allow update: if isStaff() && isValidPatient(incoming());

      match /clinical_notes/{noteId} {
        allow read: if isStaff();
        allow create: if isStaff() && isValidNote(incoming());
      }

      match /prescriptions/{rxId} {
        allow read: if isStaff();
        allow create: if isDoctor();
        allow update: if (isDoctor() || isNurse()) && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      }
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
    }
  }
}
