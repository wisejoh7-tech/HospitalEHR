# ==========================================
# BACKEND WEB SERVICE ENVIRONMENT VARIABLES
# ==========================================

# DATABASE_URL: Connection string for PostgreSQL database (Amazon RDS or Render)
# Format for Amazon RDS PostgreSQL:
# DATABASE_URL="postgresql://dbadmin:your_password@hospital-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/hospital_db?sslmode=require"
DATABASE_URL="postgresql://user:password@hostname:5432/dbname"

# ALLOWED_ORIGINS: CORS allowed origins (e.g., CloudFront distribution or custom domain)
# Examples: "https://d111111abcdef8.cloudfront.net,https://app.hospital.com"
ALLOWED_ORIGINS="https://cbt-vivi.onrender.com"

# PORT: Server port (defaults to 3000 if not specified)
PORT=3000

# NODE_ENV: Node environment ('production' or 'development')
NODE_ENV="production"

# GEMINI_API_KEY: Required for Gemini AI API calls
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where the backend web service is hosted (e.g. AWS App Runner service URL)
APP_URL="https://your-backend-service.us-east-1.awsapprunner.com"

# ADMIN CREDENTIALS (Configure custom system admin user/password on backend service)
ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@hospital.com"
ADMIN_PHONE="08000000000"
ADMIN_PASSWORD="admin"

# ==========================================
# FRONTEND STATIC SITE ENVIRONMENT VARIABLES
# ==========================================

# VITE_API_URL or VITE_API_BASE_URL: Backend API base URL for static frontend (hosted on AWS S3 + CloudFront)
# Example: https://your-backend-service.us-east-1.awsapprunner.com
VITE_API_URL="https://cbt-9v2x.onrender.com"
VITE_API_BASE_URL="https://cbt-9v2x.onrender.com"
